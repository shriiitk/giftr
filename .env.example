# ── Access control ───────────────────────────────────────────────────────────
# Comma-separated allowlist. Comparison is case-insensitive.
ALLOWED_EMAILS=you@example.com,friend@example.com
# Comma-separated invitation codes. Give each friend their own code.
# Remove one code to revoke that friend without affecting the others.
# Codes are compared case-sensitively.
INVITE_CODES=WARM-GIFT-2026,CODE-FOR-SAM,CODE-FOR-PRIYA
# Legacy single-code variable. Still supported; INVITE_CODES takes precedence
# when both are set.
# INVITE_CODE=WARM-GIFT-2026
# Long random string used to sign the 7-day session cookie.
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

# ── LLM provider ─────────────────────────────────────────────────────────────
# gemini (default) | openai | stub
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI-compatible provider (set LLM_PROVIDER=openai to use)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Rate limiting ────────────────────────────────────────────────────────────
# Idea generations allowed per session inside the window.
IDEAS_RATE_LIMIT=8
IDEAS_RATE_WINDOW_SECONDS=600
